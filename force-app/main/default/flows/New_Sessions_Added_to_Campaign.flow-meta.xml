    <assignments>
        <name>Add_Evaluation_to_Collection</name>
        <label>Add Evaluation to Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>sessionEvaluations4Insert</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>newSessionEvaluation</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Runs</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Build_Session_Evaluation</name>
        <label>Build Session Evaluation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>newSessionEvaluation.Run__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Runs.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newSessionEvaluation.Session__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newSessionEvaluation.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newSessionEvaluation.Evaluator__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Runs.Evaluator__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_Evaluation_to_Collection</targetReference>
        </connector>
    </assignments>
    <description>When a new session is added to a campaign, will add the session to all the existing evaluation runs</description>
    <environments>Default</environments>
    <interviewLabel>New Sessions Added to Campaign {!$Flow.CurrentDateTime}</interviewLabel>
    <label>New Sessions Added to Campaign</label>
    <loops>
        <name>Loop_Runs</name>
        <label>Loop Runs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Campaign_Runs</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Build_Session_Evaluation</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Insert_Session_Evaluations</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
