<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Permission set for session evaluators to access and evaluate sessions anonymously without seeing speaker information</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>dreamOle Session Evaluator</label>
    
    <!-- SessionEvaluation__c field level permissions omitted; access is provided through Apex services (SessionEvaluationService) to avoid required-field metadata deployments for master-detail relationships -->
    
    <!-- Hide all speaker-related sensitive fields (excluding them from permission set) -->
    <!-- PrimarySpeakerName__c - required field, cannot be included -->
    <!-- PrimarySpeakerEmail__c - required field, cannot be included -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Session__c.PrimarySpeakerJobTitle__c</field>
        <readable>false</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Session__c.PrimarySpeakerBio__c</field>
        <readable>false</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Session__c.PrimarySpeakerContact__c</field>
        <readable>false</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Session__c.CoSpeakerName__c</field>
        <readable>false</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Session__c.CoSpeakerEmail__c</field>
        <readable>false</readable>
    </fieldPermissions>
